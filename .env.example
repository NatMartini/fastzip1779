# Local-only sample values. Never reuse these in production.
POSTGRES_PASSWORD=local-db-only
MINIO_ROOT_USER=fastzip-local
MINIO_ROOT_PASSWORD=local-storage-only-change-me
SESSION_SECRET=local-development-only-change-before-deployment
# Change the local web port here if 8080 is in use.
FASTZIP_PORT=8080
# Compose uses http://localhost:$FASTZIP_PORT by default.
# PUBLIC_ORIGIN=http://localhost:8080
SECURE_COOKIES=false
S3_PUBLIC_ENDPOINT=http://localhost:9000
BACKUP_AGE_RECIPIENT=
