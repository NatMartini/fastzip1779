# Copy to .env.cloud.psd1 in this directory and fill in the values.
@{
    ManagerHost    = 'REPLACE_WITH_MANAGER_HOST'
    ManagerUser    = 'REPLACE_WITH_SSH_USER'
    ManagerPort    = 22
    ImageTag       = 'REPLACE_WITH_PUBLISHED_COMMIT_SHA'

    # Verify the manager host key independently. Relative paths start at this file's directory.
    KnownHostsFile = 'REPLACE_WITH_VERIFIED_KNOWN_HOSTS_FILE'

    # Optional. Leave empty to use your SSH agent or default OpenSSH key.
    IdentityFile   = ''
}
