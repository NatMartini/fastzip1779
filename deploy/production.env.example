# Non-secret manager configuration; copy to /opt/fastzip/production.env, chmod 600.
REGISTRY=ghcr.io/natmartini/fastzip1779
IMAGE_TAG=REPLACE_WITH_VERIFIED_COMMIT_SHA
DOMAIN=fastzip1779.site
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
MEDIA_BUCKET=REPLACE_WITH_PRIVATE_MEDIA_BUCKET
BACKUP_BUCKET=REPLACE_WITH_SEPARATE_PRIVATE_BACKUP_BUCKET
BACKUP_AGE_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_KEY
POSTGRES_VOLUME_PATH=/mnt/fastzip/postgres
DO_DROPLET_IDS=REPLACE_A,REPLACE_B
WORKER_REPLICAS=2
